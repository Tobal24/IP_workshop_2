# =============================================================================
# Ignorar todo por defecto (Lista Blanca / Whitelist)
# =============================================================================
*

# Mantener este archivo .gitignore
!.gitignore

# =============================================================================
# 1. Archivos de diseño en Vivado (HDL, Constraints e IPs)
# =============================================================================
!IP_workshop_2.srcs/

# Constraints (.xdc)
!IP_workshop_2.srcs/constrs_1/
!IP_workshop_2.srcs/constrs_1/**/
!IP_workshop_2.srcs/constrs_1/**/*.xdc

# Fuentes HDL (.v, .sv, .vhd)
!IP_workshop_2.srcs/sources_1/
!IP_workshop_2.srcs/sources_1/imports/
!IP_workshop_2.srcs/sources_1/imports/**/
!IP_workshop_2.srcs/sources_1/imports/**/*.v
!IP_workshop_2.srcs/sources_1/imports/**/*.sv
!IP_workshop_2.srcs/sources_1/imports/**/*.vhd

# Bloques de configuración de IP (.xci) en sus carpetas correspondientes
!IP_workshop_2.srcs/sources_1/ip/
!IP_workshop_2.srcs/sources_1/ip/*/
!IP_workshop_2.srcs/sources_1/ip/*/*.xci

# =============================================================================
# 2. Archivo de MATLAB con las funciones
# =============================================================================
!IEEE-conference-template-062824/
!IEEE-conference-template-062824/*.m
!*.m
